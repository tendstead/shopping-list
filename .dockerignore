# Local environment files at every depth; keep credential-free examples.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Credentials, private keys and local database exports.
**/secrets/
**/certs/
**/backups/
/database-password
/database-password.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.keystore
**/*.dump
**/*.backup
**/*.sql.gz
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*

# Local logs, editor/assistant settings and operating-system metadata.
**/*.log
**/.idea/
**/.vscode/
**/.codex/
**/.DS_Store
**/Thumbs.db
